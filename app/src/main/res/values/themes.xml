<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZipTonton" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lamp</item>
        <item name="colorOnPrimary">@color/on_lamp</item>
        <item name="colorPrimaryContainer">@color/lamp</item>
        <item name="colorOnPrimaryContainer">@color/on_lamp</item>
        <item name="colorSecondaryContainer">@color/surface_2</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/dim</item>
        <item name="colorSurfaceContainer">@color/surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ZipTonton.Player" parent="Theme.ZipTonton">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Teks -->
    <style name="T.Display" parent="">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="T.Title" parent="">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="T.Section" parent="">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="T.Body" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="T.Meta" parent="">
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="IconBtn" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="Shape.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
